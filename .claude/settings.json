{
  "enabledPlugins": {
    "artisan-agent@artisan-agent": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "artisan-agent": {
      "source": {
        "source": "github",
        "repo": "arathianevasion/artisan-agent"
      }
    }
  },
  "permissions": {
    "deny": [
      "Skill(mattpocock-skills:implement-spec)",
      "Skill(mattpocock-skills:implement)",
      "Skill(mattpocock-skills:to-spec)",
      "Skill(mattpocock-skills:retro)",
      "Skill(mattpocock-skills:triage)",
      "Skill(mattpocock-skills:grill-with-docs)"
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "70"
  }
}
