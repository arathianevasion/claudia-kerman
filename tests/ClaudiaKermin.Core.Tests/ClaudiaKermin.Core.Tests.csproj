<!--
  Core tests. They run on modern .NET (no Mono needed on macOS or CI) against the net48 core
  assembly that ships to KSP, so the core must stick to APIs both runtimes have.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- NU1702: referencing the net48 core from net10.0 is deliberate (see above). -->
    <NoWarn>$(NoWarn);NU1702</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Recorded Claude streams, replayed byte for byte. -->
  <ItemGroup>
    <None Include="Fixtures/**/*.sse" CopyToOutputDirectory="PreserveNewest" />
    <!-- Game Snapshots, in the JSON the debug capture button writes. -->
    <None Include="Fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The kOS documented built-in names (see KosBuiltinNames.cs). -->
    <None Include="Fixtures/kos-builtins-documented.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The launch trace lines of a flight, as KSP.log has them, for the ascent replay (AscentReplay.cs). -->
    <None Include="Fixtures/ascent-replay/*.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- One golden file per Building Block: its //| doc lines (BlockDocsSnapshotTests, ADR 0014). -->
    <None Include="Fixtures/block-docs/*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ClaudiaKermin.Core/ClaudiaKermin.Core.csproj" />
    <!-- The #534 probes build their requests in Probes; SchemaProbeTests pins them. -->
    <ProjectReference Include="../../tools/ClaudiaKermin.SchemaProbe/ClaudiaKermin.SchemaProbe.csproj" />
  </ItemGroup>
</Project>
