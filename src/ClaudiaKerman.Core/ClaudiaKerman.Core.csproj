<!--
  The Unity-free core (ADR 0001): mission orchestration, the Claude client, prompt building and
  Mission state. It must never reference Unity or KSP assemblies, so it builds and tests anywhere.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ClaudiaKerman.Core</AssemblyName>
    <RootNamespace>ClaudiaKerman.Core</RootNamespace>
    <ShipsInGameData>true</ShipsInGameData>
  </PropertyGroup>

  <!-- The structured-output schemas and their union budget (#199), for the tests and the schema probe tool; the base
       layer's worked example (#285), for the real Script Check's tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="ClaudiaKerman.Core.Tests" />
    <InternalsVisibleTo Include="ClaudiaKerman.SchemaProbe" />
    <InternalsVisibleTo Include="ClaudiaKerman.ScriptCheck.Tests" />
    <InternalsVisibleTo Include="ClaudiaKerman.Kerboscript.Tests" />
  </ItemGroup>

  <!-- The Core Library ships inside the core, so bundling a Mission Script reads no files. -->
  <ItemGroup>
    <EmbeddedResource Include="$(RepoRoot)kerboscript/library/*.ks" LogicalName="ClaudiaKerman.Core.library.%(Filename).ks" />
    <!-- The mod's own program on the Target Vessel while dock flies (#456): not in the bundle, not in Claudia's docs. -->
    <EmbeddedResource Include="$(RepoRoot)kerboscript/dock_hold/dock_hold.ks" LogicalName="ClaudiaKerman.Core.dock_hold.ks" />
  </ItemGroup>
</Project>
